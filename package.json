{
  "name": "codex-control-panel",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Demo-first ANSI terminal interface for Codex role-workflow fixtures",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "workflow": "node scripts/workflow-window.js",
    "jev:setup": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/jev-key.ps1",
    "jev:check": "node scripts/jev-check.js",
    "live": "node scripts/live.js",
    "live:check": "node scripts/live.js --check",
    "live:login": "node scripts/live.js --login",
    "start": "node scripts/cli.js",
    "demo": "node scripts/tui.js",
    "cli:install": "node scripts/cli.js --install-only",
    "plugin:install": "node scripts/install-user-plugin.js",
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.js",
    "probe": "node scripts/probe.js",
    "test:ui": "node scripts/ui-test.cjs",
    "tui": "node scripts/tui.js",
    "web": "node src/server.js",
    "test:tui": "node --test test/tui.test.js"
  }
}
